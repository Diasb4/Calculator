# GradeMaster environment variables.
# On the VPS, docker-compose.yml already sets NODE_ENV, HOST, PORT, BOT_POLLING,
# ENABLE_BACKGROUND_CRON and REDIS_URL; .env only needs the secrets below.

# --- Telegram ---------------------------------------------------------------
# Bot token from @BotFather (required).
TELEGRAM_BOT_TOKEN=
# Admin chat id(s), comma-separated: /admin, morning stats, broadcasts (required in production).
ADMIN_CHAT_ID=
# Chat that receives website feedback (api/telegram.js on Vercel); also the admin fallback.
TELEGRAM_CHAT_ID=
# Webhook mode only: secret Telegram sends with every update, at least 32 characters.
TELEGRAM_SECRET_TOKEN=
# Bot username without @ (optional; looked up via getMe when empty).
TELEGRAM_BOT_USERNAME=

# --- Secrets ------------------------------------------------------------------
# Encrypts student sessions at rest: openssl rand -base64 32. Losing or changing it
# invalidates every stored session (students must reconnect).
SESSION_ENC_KEY=
# Bearer token required by /api/cron and GET /api/stats: openssl rand -hex 32.
CRON_SECRET=
# Salt for anonymous analytics pseudonyms; defaults to the bot token when empty.
ANALYTICS_SALT=

# --- Storage: set exactly one backend -----------------------------------------
# Redis over TCP (the VPS stack sets this in docker-compose.yml).
REDIS_URL=
# Or Upstash / Vercel KV REST API (UPSTASH_REDIS_REST_URL / _TOKEN also accepted).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Runtime --------------------------------------------------------------------
# 'true': receive updates by long polling (removes any webhook); webhook POSTs are refused.
BOT_POLLING=false
# 'true': run the reminder cron in-process every 15 minutes (VPS).
ENABLE_BACKGROUND_CRON=false
# '1' only behind a reverse proxy that sets X-Forwarded-For; otherwise the socket address is used.
TRUST_PROXY=
# Public site URL, used in bot links and for webhook setup.
WEBAPP_URL=https://calculator-not-404.vercel.app
# HTTP listener.
PORT=3000
HOST=0.0.0.0

# --- AITU integrations ---------------------------------------------------------
# Learn sessionid used for admin chats that have not connected their own.
AITU_SESSION_ID=
# Moodle calendar URL / session used for admin chats that have not connected their own.
AITU_LMS_SESSION_ID=
# Extra host allowed for LMS calendar URLs besides lms.astanait.edu.kz.
LMS_ALLOWED_HOST=
# Subscriber caps (Learn defaults to 70, LMS to 200).
AITU_MAX_SUBSCRIBERS_LIMIT=
LMS_MAX_SUBSCRIBERS_LIMIT=

# --- Website click log (api/telegram.js) ----------------------------------------
# '1' forwards website click logs to TELEGRAM_CHAT_ID.
WEBLOG_ENABLED=
# Prefix line added to click logs.
TELEGRAM_TAG=
